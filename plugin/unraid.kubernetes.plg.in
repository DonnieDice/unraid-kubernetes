<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN
  name="unraid.kubernetes"
  author="Donnie Dice"
  version="@VERSION@"
  launch="Kubernetes"
  icon="kubernetes.png"
  pluginURL="https://raw.githubusercontent.com/DonnieDice/unraid-kubernetes/main/plugin/unraid.kubernetes.plg"
  min="7.1.0">

<CHANGES>
<![CDATA[
### @VERSION@
- Keep Kubernetes tables within their Unraid content area without false horizontal scrollbars.
- Add direct GitHub Discussions help and support links.
- Correct project documentation to match the shipped status command paths.

### 0.1.4
- Add independent visibility controls for the Dashboard widget, Kubernetes page, and Docker page panel.
- Add Automatic, percent-core, and core CPU display units.
- Remove the invalid Community Applications forum-support metadata.

### 0.1.3
- Restore the Kubernetes runtime section above Docker containers with a native page header.
- Show live runtime CPU and memory usage with Docker Advanced View.
- Show optional live node, namespace, and pod usage from the Kubernetes Metrics API.
- Tighten Kubernetes page spacing and runtime row density.

### 0.1.2
- Keep Kubernetes pages within the visible viewport when Unraid retains its desktop minimum width.
- Preserve readable tables with local horizontal scrolling and responsive settings fields.

### 0.1.1
- Keep the Kubernetes runtime summary embedded above Docker containers in both tabbed and non-tabbed views.
- Add the plugin icon and human-readable Plugin Manager description.

### 0.1.0
- Initial native Unraid Kubernetes page and dashboard tile.
- Add safe k3d installation, cluster adoption, and lifecycle integration.
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/unraid.kubernetes/k3d-v5.9.0-linux-amd64">
<URL>https://github.com/k3d-io/k3d/releases/download/v5.9.0/k3d-linux-amd64</URL>
<SHA256>06d8f25bc3a971c4eb29e0ff08429b180402db0f4dec838c9eac427e296800a0</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/unraid.kubernetes/unraid.kubernetes-@VERSION@-noarch-1.txz">
<URL>https://github.com/DonnieDice/unraid-kubernetes/releases/download/v@VERSION@/unraid.kubernetes-@VERSION@-noarch-1.txz</URL>
<SHA256>@PACKAGE_SHA256@</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/unraid.kubernetes/unraid.kubernetes-@VERSION@-noarch-1.txz
install -m 0755 /boot/config/plugins/unraid.kubernetes/k3d-v5.9.0-linux-amd64 /usr/local/bin/k3d
/usr/local/emhttp/plugins/unraid.kubernetes/scripts/install.sh
rm -f $(ls /boot/config/plugins/unraid.kubernetes/unraid.kubernetes-*-noarch-1.txz 2>/dev/null | grep -v '@VERSION@')
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
/etc/rc.d/rc.unraid-kubernetes stop 2>/dev/null || true
removepkg unraid.kubernetes
rm -rf /usr/local/emhttp/plugins/unraid.kubernetes
rm -f /etc/rc.d/rc.unraid-kubernetes
rm -f /usr/local/bin/k3d
]]>
</INLINE>
</FILE>

</PLUGIN>
